// Campaign, account, and campaign access data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  FINISHED
  ARCHIVED
}

enum CampaignRole {
  DM
  PLAYER
}

enum CampaignThemeColor {
  GOLD
  BLUE
  SAGE
  ROSE
  VIOLET
}

enum CampaignIcon {
  SUN
  WAVE
  TOWER
  MOON
  STAR
}

model Campaign {
  id          String               @id @default(cuid())
  title       String               @db.VarChar(80)
  description String?              @db.VarChar(500)
  edition     String               @default("D&D 5e · 2014") @db.VarChar(80)
  status      CampaignStatus       @default(ACTIVE)
  initialLevel Int                 @default(1)
  themeColor  CampaignThemeColor   @default(GOLD)
  icon        CampaignIcon         @default(SUN)
  tags        String[]             @default([])
  playerCanViewDescription Boolean @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  ownerId     String
  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  memberships CampaignMembership[]
  invitations CampaignInvitation[]

  @@index([status, updatedAt])
  @@index([ownerId, updatedAt])
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique @db.VarChar(254)
  emailVerified   Boolean              @default(false)
  passwordHash    String               @db.VarChar(255)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  campaigns       Campaign[]
  memberships     CampaignMembership[]
  sentInvitations CampaignInvitation[] @relation("CampaignInvitationSender")
  sessions        Session[]
  emailTokens     EmailToken[]
}

model CampaignMembership {
  campaignId String
  userId     String
  role       CampaignRole @default(PLAYER)
  createdAt  DateTime     @default(now())
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([userId, createdAt])
}

model CampaignInvitation {
  id              String       @id @default(cuid())
  campaignId      String
  invitedByUserId String
  email           String       @db.VarChar(254)
  role            CampaignRole @default(PLAYER)
  tokenHash       String       @unique @db.VarChar(64)
  createdAt       DateTime     @default(now())
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  campaign        Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  invitedBy       User         @relation("CampaignInvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([campaignId, email, expiresAt])
  @@index([invitedByUserId, createdAt])
}

model EmailToken {
  // This is the SHA-256 of a single-use random token, never the raw token.
  id          String   @id @db.VarChar(64)
  purpose     String   @db.VarChar(32)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String   @db.VarChar(254)
  fingerprint String?  @db.VarChar(64)
  createdAt   DateTime
  expiresAt   DateTime

  @@index([userId, purpose])
  @@index([expiresAt])
}

model RateLimit {
  key            String    @id @db.VarChar(512)
  totalHits      Int
  expiresAt      DateTime
  isBlocked      Boolean   @default(false)
  blockExpiresAt DateTime?

  @@index([expiresAt])
}

model Session {
  // The authentication package stores only the SHA-256 cookie-token hash here.
  id           String   @id @db.VarChar(64)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  lastActiveAt DateTime
  mfa          String?
  metadata     Json?

  @@index([userId])
  @@index([expiresAt])
}
