// Campaign data for the first API slice. Ownership and memberships will be
// added alongside authentication before multi-user access is enabled.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  FINISHED
  ARCHIVED
}

model Campaign {
  id          String         @id @default(cuid())
  title       String         @db.VarChar(80)
  description String?        @db.VarChar(500)
  edition     String         @default("D&D 5e · 2014") @db.VarChar(80)
  status      CampaignStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, updatedAt])
}
