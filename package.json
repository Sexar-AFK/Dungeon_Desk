{
  "name": "dungeon-desk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dungeon-desk/web --filter @dungeon-desk/api dev",
    "dev:web": "pnpm --filter @dungeon-desk/web dev",
    "dev:api": "pnpm --filter @dungeon-desk/api dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --filter @dungeon-desk/api test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:backup": "pnpm --filter @dungeon-desk/api db:backup"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
